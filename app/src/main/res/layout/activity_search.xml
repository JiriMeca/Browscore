<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome-style search activity (launched by the home screen widget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/browser_bg"
    android:fitsSystemWindows="true">

    <!-- ===== Top search bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/browser_bg"
        android:elevation="2dp">

        <!-- Cancel / back button -->
        <ImageButton
            android:id="@+id/search_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_done"
            android:scaleType="center"
            app:tint="@color/icon_default"
            android:onClick="finish" />

        <!-- Search pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_omnibox"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <!-- Search icon -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null"
                app:tint="@color/text_hint" />

            <!-- Search input -->
            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"
                android:hint="@string/hint_search_url"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:background="@android:color/transparent"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:ellipsize="end" />

            <!-- Clear button -->
            <ImageView
                android:id="@+id/search_clear_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/action_done"
                android:scaleType="center"
                android:padding="4dp"
                app:tint="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ===== Suggestion list ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_suggestion_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />
</LinearLayout>
