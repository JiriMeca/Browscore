<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Round 10: per-site permission manager — runtime permissions requested on demand. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BrowserApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermanentBrowser"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_history" />

        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_bookmarks" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_settings" />

        <!-- Round 10: per-site permission manager screen -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_permissions" />

        <!--
            Dedicated search Activity — PUBLIC, callable by any app.

            How other apps can launch Brows search:
              • KWGT / Tasker / MacroDroid / custom widgets:
                  new ComponentName("com.permanentbrowser.app", "com.permanentbrowser.app.SearchActivity")
                  action = "com.permanentbrowser.app.ACTION_SEARCH"
                  putExtra("query", "hello")
              • Android Assistant / voice:
                  ACTION_WEB_SEARCH  +  SearchManager.QUERY
              • Share menu:
                  ACTION_SEND  +  text/plain EXTRA_TEXT
              • Shortcut makers:
                  ACTION_SEARCH  +  SearchManager.QUERY

            Accepts extras (any name works, checked in priority order):
              1. "com.permanentbrowser.app.SEARCH_QUERY"
              2. SearchManager.QUERY
              3. "query"
              4. Intent.EXTRA_TEXT  (from ACTION_SEND)
        -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:label="@string/widget_name"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.PermanentBrowser"
            android:windowSoftInputMode="adjustResize">

            <!-- Custom action for third-party widgets / shortcuts -->
            <intent-filter>
                <action android:name="com.permanentbrowser.app.ACTION_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Android global search (voice assistants, search bar) -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Accept text/plain SEND for quick sharing into search -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Accept ASSIST so Google Assistant / system assistant can forward queries -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Search widget: resizable 3×1 pill (Brows logo + mic icon). -->
        <receiver
            android:name=".SearchWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_provider_info" />
        </receiver>
    </application>

</manifest>
